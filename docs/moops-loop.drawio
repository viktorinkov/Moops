  <diagram id="moops-claude-mem" name="MOOPS + Claude-Mem verification loop">
    <mxGraphModel dx="2000" dy="6000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="6000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1"><mxGeometry width="2000" height="6000" as="geometry"/></mxCell>
        <mxCell id="title" value="MOOPS + CLAUDE-MEM" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=48;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="220" y="25" width="1100" height="65" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="THE REAL iOS VERIFICATION LOOP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=32;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="220" y="92" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="impact" value="MEMORY AS A SPEED PLAY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C4B5FD;strokeWidth=2;fontFamily=Helvetica;fontSize=19;fontStyle=1;fontColor=#6B21A8;" vertex="1" parent="1"><mxGeometry x="1460" y="58" width="320" height="54" as="geometry"/></mxCell>
        <mxCell id="workflow" value="recall → validate → rebuild → restore → agent inspects + verifies fresh evidence" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="220" y="170" width="1560" height="70" as="geometry"/></mxCell>

        <mxCell id="recall-label" value="1 · REQUIRED RECALL + FAIL-CLOSED VALIDATION" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#6B21A8;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="220" y="290" width="720" height="50" as="geometry"/></mxCell>

        <mxCell id="goal" value="&lt;b&gt;FRESH CODEX PROCESS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Edits the real Xcode project.&lt;br&gt;Calls MOOPS and receives evidence.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;&lt;b&gt;Agent owns inspection + verification.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=30;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=2;fontFamily=Helvetica;fontSize=26;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="220" y="380" width="540" height="260" as="geometry"/></mxCell>

        <mxCell id="memory" value="&lt;b&gt;CLAUDE-MEM · REQUIRED MEMORY LAYER&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot; color=&quot;#7E22CE&quot;&gt;search → timeline → get_observations&lt;/font&gt;&lt;br&gt;&lt;br&gt;Fresh Codex recalls captured descriptors.&lt;br&gt;Selects &lt;b&gt;checkout-ready&lt;/b&gt; with path + fingerprint.&lt;br&gt;Never app process memory.&lt;br&gt;&lt;br&gt;&lt;b&gt;Recall failure stops the workflow.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=30;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=4;fontFamily=Helvetica;fontSize=24;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="220" y="980" width="540" height="350" as="geometry"/></mxCell>

        <mxCell id="cli" value="&lt;b&gt;MOOPS CLI · NODE.JS&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot; color=&quot;#2563EB&quot;&gt;tools/moops/moops&lt;/font&gt;&lt;br&gt;&lt;br&gt;• validates schema + canonical SHA-256&lt;br&gt;• checks app + simulator preconditions&lt;br&gt;• runs build → install → launch → replay → capture&lt;br&gt;• stops on the first failed phase&lt;br&gt;• returns stable JSON evidence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=30;spacingLeft=145;spacingRight=24;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="220" y="1700" width="540" height="350" as="geometry"/></mxCell>
        <mxCell id="node-cli" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml;base64,;" vertex="1" parent="1"><mxGeometry x="260" y="1760" width="90" height="102" as="geometry"/></mxCell>

        <mxCell id="checkpoint" value="&lt;b&gt;VERSIONED CHECKPOINT&lt;/b&gt;&lt;br&gt;&lt;br&gt;• app + simulator identity&lt;br&gt;• declared fixture version&lt;br&gt;• direct adapter arguments&lt;br&gt;• public wait + tap trace&lt;br&gt;• UI landing predicates&lt;br&gt;&lt;br&gt;&lt;b&gt;Descriptor + replay recipe. Never a snapshot.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=30;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="1260" y="1700" width="540" height="350" as="geometry"/></mxCell>

        <mxCell id="mcp" value="&lt;b&gt;XCODE PROJECT + MCP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Codex inspects and edits the real Xcode project.&lt;br&gt;&lt;br&gt;The project bridge stays outside MOOPS." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=30;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=3;dashed=1;fontFamily=Helvetica;fontSize=24;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1260" y="380" width="540" height="260" as="geometry"/></mxCell>
        <mxCell id="gate-note" value="&lt;b&gt;FAIL-CLOSED ADMISSION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bad fingerprint, missing state, failed trace, or failed predicate returns an exact JSON error." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=30;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=2;fontFamily=Helvetica;fontSize=22;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="1260" y="2210" width="540" height="180" as="geometry"/></mxCell>

        <mxCell id="build-label" value="2 · REBUILD, THEN REPLAY THE SHORTEST PUBLIC ROUTE" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#075985;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="220" y="2490" width="760" height="50" as="geometry"/></mxCell>

        <mxCell id="build" value="&lt;b&gt;1 · BUILD&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot; color=&quot;#2563EB&quot;&gt;xcodebuild build-for-testing&lt;/font&gt;&lt;br&gt;&lt;br&gt;Compile the structural edit into a new app binary." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=35;spacingLeft=175;spacingRight=30;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="220" y="2600" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="xcode-build" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/png;base64,;" vertex="1" parent="1"><mxGeometry x="260" y="2680" width="110" height="110" as="geometry"/></mxCell>
        <mxCell id="install" value="&lt;b&gt;2 · INSTALL&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot; color=&quot;#4F46E5&quot;&gt;simctl install&lt;/font&gt;&lt;br&gt;&lt;br&gt;Replace the app binary without uninstalling it.&lt;br&gt;&lt;br&gt;&lt;b&gt;The installed app sandbox stays.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="1260" y="2600" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="launch" value="&lt;b&gt;3 · LAUNCH&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot; color=&quot;#D97706&quot;&gt;simctl launch&lt;/font&gt;&lt;br&gt;&lt;br&gt;Start a new operating-system process.&lt;br&gt;&lt;br&gt;&lt;b&gt;In-memory views and navigation are gone.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="1260" y="3300" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="replay" value="&lt;b&gt;4 · XCUITEST REPLAY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;Apple black-box UI automation&lt;/font&gt;&lt;br&gt;&lt;br&gt;Reacquire elements. Wait + tap by accessibility ID.&lt;br&gt;&lt;br&gt;&lt;b&gt;Return a fresh machine-readable UI tree.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#164E63;" vertex="1" parent="1"><mxGeometry x="220" y="3300" width="540" height="280" as="geometry"/></mxCell>

        <mxCell id="state-label" value="3 · STATE STAYS WITH ITS REAL OWNER" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#166534;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="220" y="3820" width="570" height="50" as="geometry"/></mxCell>
        <mxCell id="boundary-note" value="&lt;b&gt;THE KEY BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Claude-Mem recalls a descriptor. MOOPS validates and executes it.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;&lt;b&gt;Neither one serializes, copies, or fabricates app state.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=40;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=2;fontFamily=Helvetica;fontSize=26;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="220" y="3910" width="1560" height="210" as="geometry"/></mxCell>

        <mxCell id="app" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="220" y="4500" width="1560" height="600" as="geometry"/></mxCell>
        <mxCell id="app-title" value="REAL iOS APP · Swift / SwiftUI · installed simulator data container" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="280" y="4540" width="1400" height="55" as="geometry"/></mxCell>
        <mxCell id="durable" value="&lt;b&gt;SURVIVES REBUILD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;installed app sandbox&lt;/font&gt;&lt;br&gt;&lt;br&gt;• authenticated session&lt;br&gt;• Core Data cart (local database)&lt;br&gt;• UserDefaults preference (local key-value storage)&lt;br&gt;&lt;br&gt;&lt;b&gt;MOOPS validates this state. It never copies it.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#FFFFFF;strokeColor=#4ADE80;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="280" y="4640" width="560" height="390" as="geometry"/></mxCell>
        <mxCell id="ephemeral" value="&lt;b&gt;RECREATED AFTER LAUNCH&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;new operating-system process&lt;/font&gt;&lt;br&gt;&lt;br&gt;• SwiftUI view objects&lt;br&gt;• view-model memory&lt;br&gt;• NavigationStack (in-memory screen path)&lt;br&gt;&lt;br&gt;&lt;b&gt;Public XCUITest replay rebuilds navigation.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="1160" y="4640" width="560" height="390" as="geometry"/></mxCell>

        <mxCell id="backend" value="&lt;b&gt;NODE.JS BACKEND&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;separate process + truth boundary&lt;/font&gt;&lt;br&gt;&lt;br&gt;GET catalog + prices&lt;br&gt;POST /orders&lt;br&gt;&lt;br&gt;&lt;b&gt;Independent receipt. Never checkpointed.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;fontFamily=Helvetica;fontSize=24;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="220" y="5510" width="520" height="300" as="geometry"/></mxCell>

        <mxCell id="evidence-label" value="4 · THE AGENT INSPECTS + VERIFIES FRESH EVIDENCE" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#166534;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1060" y="5420" width="720" height="50" as="geometry"/></mxCell>
        <mxCell id="evidence" value="&lt;b&gt;AGENT INSPECTS + VERIFIES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;MOOPS report&lt;/b&gt; · checkpoint · fingerprint · failed/passed phase · predicates&lt;br&gt;&lt;b&gt;Backend receipt&lt;/b&gt; · exact POST /orders payload outside MOOPS&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;&lt;b&gt;All checks pass → continue.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;Mismatch → return the exact failed phase.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=35;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=4;fontFamily=Helvetica;fontSize=22;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1060" y="5510" width="720" height="300" as="geometry"/></mxCell>
        <mxCell id="loop-label" value="REPEAT UNTIL DONE" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;horizontal=0;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="70" y="2800" width="46" height="280" as="geometry"/></mxCell>

        <mxCell id="e-goal-memory" value="query memory" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333EA;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#7E22CE;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="goal" target="memory"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-memory-cli" value="recalled descriptor" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333EA;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#7E22CE;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="memory" target="cli"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cli-checkpoint" value="checkpoint input" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#475569;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="checkpoint" target="cli"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-mcp-goal" value="inspect + edit" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#60A5FA;strokeWidth=4;startArrow=block;startFill=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#2563EB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="goal" target="mcp"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cli-build" value="validated restore recipe" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1D4ED8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cli" target="build"><mxGeometry x="0" y="-38" relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="2280"/><mxPoint x="1010" y="2280"/><mxPoint x="1010" y="2550"/><mxPoint x="490" y="2550"/></Array></mxGeometry></mxCell>
        <mxCell id="e-build-install" value="new binary" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="build" target="install"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-install-launch" value="keep app sandbox" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4F46E5;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#4338CA;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="install" target="launch"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-launch-replay" value="new process" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D97706;strokeWidth=5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#B45309;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="launch" target="replay"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-install-durable" value="public replay" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0891B2;strokeWidth=4;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#0E7490;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="replay" target="app"><mxGeometry x="0" y="-38" relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="3440"/><mxPoint x="140" y="4800"/></Array></mxGeometry></mxCell>
        <mxCell id="e-http" value="HTTP GET + POST" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EA580C;strokeWidth=4;startArrow=block;startFill=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#C2410C;exitX=0.1667;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="app" target="backend"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-replay-evidence" value="MOOPS JSON + fresh UI tree" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0891B2;strokeWidth=4;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#0E7490;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="replay" target="evidence"><mxGeometry x="0" y="-38" relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="3440"/><mxPoint x="1900" y="5660"/></Array></mxGeometry></mxCell>
        <mxCell id="e-backend-evidence" value="POST receipt" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EA580C;strokeWidth=4;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#C2410C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="backend" target="evidence"><mxGeometry x="0" y="-38" relative="1" as="geometry"/></mxCell>
        <mxCell id="e-loop" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 5;strokeColor=#16A34A;strokeWidth=5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="evidence" target="goal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="5900"/><mxPoint x="40" y="5900"/><mxPoint x="40" y="510"/></Array></mxGeometry></mxCell>
