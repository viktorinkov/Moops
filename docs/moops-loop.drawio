  <diagram id="implemented-moops" name="Implemented MOOPS architecture">
    <mxGraphModel dx="1360" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1"><mxGeometry width="1360" height="1100" as="geometry"/></mxCell>
        <mxCell id="title" value="IMPLEMENTED MOOPS ARCHITECTURE / STATE MODEL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="48" y="26" width="850" height="38" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Node.js host: tools/moops/moops · checkpoint | doctor | verify | build-and-restore" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="48" y="65" width="940" height="26" as="geometry"/></mxCell>
        <mxCell id="workflow" value="define + verify checkpoint → agent edit → build-and-restore CHECKPOINT → JSON evidence → Goal continues" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="48" y="101" width="860" height="30" as="geometry"/></mxCell>
        <mxCell id="control-label" value="CONTROL PLANE" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="48" y="150" width="128" height="24" as="geometry"/></mxCell>

        <mxCell id="goal" value="&lt;b&gt;EXTERNAL CODEX GOAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Edits the app, invokes MOOPS, consumes evidence, and owns the repeat loop.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;No LLM runs inside MOOPS.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="48" y="184" width="210" height="160" as="geometry"/></mxCell>
        <mxCell id="cli" value="&lt;b&gt;MOOPS CLI / API · Node.js&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;tools/moops/moops&lt;/font&gt;&lt;br&gt;&lt;br&gt;• checkpoint · schema + fingerprint&lt;br&gt;• doctor · adapter admission&lt;br&gt;• verify · fresh inspect + landing&lt;br&gt;• build-and-restore · full pipeline&lt;br&gt;&lt;br&gt;Direct argv execution; nonzero on failure." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="292" y="170" width="248" height="194" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;VERSIONED CHECKPOINT REGISTRY · JSON&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;benchmark/checkpoints/*.json&lt;/font&gt;&lt;br&gt;&lt;br&gt;schemaVersion + fixtureVersion&lt;br&gt;app / simulator identity&lt;br&gt;declared adapter argv&lt;br&gt;public trace: wait / tap&lt;br&gt;landing predicates + durable preconditions&lt;br&gt;canonical SHA-256 fingerprint&lt;br&gt;&lt;br&gt;&lt;b&gt;Descriptor + recipe; never a snapshot.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="574" y="158" width="280" height="218" as="geometry"/></mxCell>
        <mxCell id="engine" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="894" y="150" width="418" height="226" as="geometry"/></mxCell>
        <mxCell id="engine-title" value="BUILD / RESTORE ENGINE · fixed order, fail closed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="914" y="166" width="370" height="25" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;1 BUILD&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;xcrun xcodebuild&lt;/font&gt;&lt;br&gt;build-for-testing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontFamily=Helvetica;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="914" y="202" width="179" height="70" as="geometry"/></mxCell>
        <mxCell id="install" value="&lt;b&gt;2 INSTALL&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;CoreSimulator simctl install&lt;/font&gt;&lt;br&gt;&lt;b&gt;NO uninstall&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#EEF2FF;strokeColor=#4F46E5;fontFamily=Helvetica;fontSize=11;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="1113" y="202" width="179" height="70" as="geometry"/></mxCell>
        <mxCell id="launch" value="&lt;b&gt;3 LAUNCH&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;simctl launch&lt;/font&gt;&lt;br&gt;new app process" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#EEF2FF;strokeColor=#4F46E5;fontFamily=Helvetica;fontSize=11;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="914" y="288" width="179" height="70" as="geometry"/></mxCell>
        <mxCell id="replay" value="&lt;b&gt;4 REPLAY + INSPECT&lt;/b&gt;&lt;br&gt;XCUITest · protocol v1&lt;br&gt;one test session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFEFF;strokeColor=#0891B2;fontFamily=Helvetica;fontSize=11;fontColor=#164E63;" vertex="1" parent="1"><mxGeometry x="1113" y="288" width="179" height="70" as="geometry"/></mxCell>

        <mxCell id="mcp" value="&lt;b&gt;OFFICIAL XCODE MCP&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;/usr/bin/xcrun mcpbridge&lt;/font&gt;&lt;br&gt;External Codex ↔ Xcode project&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;outside the MOOPS host&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#60A5FA;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="48" y="374" width="210" height="86" as="geometry"/></mxCell>
        <mxCell id="project-input" value="&lt;b&gt;ADOPTER INPUT&lt;/b&gt;&lt;br&gt;iOS / Xcode project + booted simulator&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;MOOPS_SIMULATOR_UDID&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;MOOPS_DERIVED_DATA&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="292" y="394" width="248" height="76" as="geometry"/></mxCell>
        <mxCell id="gate-note" value="Fingerprint mismatch, malformed schema, missing env, adapter failure, or failed predicate stops the workflow with a JSON error." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF7ED;strokeColor=#FDBA74;fontFamily=Helvetica;fontSize=11;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="574" y="394" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="adapter" value="&lt;b&gt;APP-SPECIFIC UI ADAPTER · extension point&lt;/b&gt;&lt;br&gt;Receives protocol-v1 trace + selectors; returns one public accessibility observation.&lt;br&gt;The checked-in FoodDelivery XCUITest adapter exercises the complete path." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=13;fillColor=#ECFEFF;strokeColor=#22D3EE;fontFamily=Helvetica;fontSize=11;fontColor=#164E63;" vertex="1" parent="1"><mxGeometry x="894" y="394" width="418" height="76" as="geometry"/></mxCell>

        <mxCell id="state-label" value="STATE PLANE / OWNERSHIP" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="48" y="496" width="178" height="24" as="geometry"/></mxCell>
        <mxCell id="app" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="48" y="530" width="842" height="286" as="geometry"/></mxCell>
        <mxCell id="app-title" value="REAL iOS APP · Swift / SwiftUI · simulator app data container" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="74" y="546" width="650" height="29" as="geometry"/></mxCell>
        <mxCell id="durable" value="&lt;b&gt;SURVIVES REBUILD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;Preserved because install never uninstalls the app&lt;/font&gt;&lt;br&gt;&lt;br&gt;• authenticated session / app container&lt;br&gt;• Core Data cart&lt;br&gt;• UserDefaults delivery preference&lt;br&gt;&lt;br&gt;&lt;b&gt;MOOPS validates assumptions; it does not copy this state.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#4ADE80;fontFamily=Helvetica;fontSize=12;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="74" y="590" width="368" height="194" as="geometry"/></mxCell>
        <mxCell id="ephemeral" value="&lt;b&gt;DESTROYED / RECREATED ON LAUNCH&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;New process: no process-memory checkpoint&lt;/font&gt;&lt;br&gt;&lt;br&gt;• SwiftUI view objects&lt;br&gt;• view-model memory&lt;br&gt;• live NavigationStack / path&lt;br&gt;&lt;br&gt;&lt;b&gt;Navigation is reconstructed only by the public XCUITest replay trace.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFBEB;strokeColor=#F59E0B;fontFamily=Helvetica;fontSize=12;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="470" y="590" width="394" height="194" as="geometry"/></mxCell>
        <mxCell id="backend" value="&lt;b&gt;EXTERNAL STATE OWNER&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9A3412&quot;&gt;Deterministic local Node.js HTTP backend&lt;/font&gt;&lt;br&gt;&lt;br&gt;GET catalog + prices&lt;br&gt;POST /orders&lt;br&gt;independent order receipt&lt;br&gt;&lt;br&gt;Separate process / truth boundary.&lt;br&gt;Never copied into a checkpoint." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="930" y="548" width="382" height="236" as="geometry"/></mxCell>

        <mxCell id="memory" value="&lt;b&gt;OPTIONAL MEMORY-PROVIDER SIDECAR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7E22CE&quot;&gt;Claude-Mem · local SQLite&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;search → timeline → get_observations&lt;/font&gt;&lt;br&gt;returns checkpoint name / path / fingerprint&lt;br&gt;&lt;br&gt;&lt;b&gt;Selects a descriptor only.&lt;/b&gt;&lt;br&gt;Never restores or verifies state; the JSON gate still decides." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=17;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="48" y="854" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="evidence" value="&lt;b&gt;MACHINE-READABLE EVIDENCE TO EXTERNAL GOAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;MOOPS JSON report&lt;/b&gt;&lt;br&gt;checkpoint name + fingerprint · phase success/failure · fresh accessibility landing results · elapsedMs · stable error code&lt;br&gt;&lt;br&gt;&lt;b&gt;Independent application evidence&lt;/b&gt;&lt;br&gt;the local HTTP backend retains the POST receipt outside MOOPS&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;Verified observation → Goal continues. Failure → exact failed phase returns to Goal.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=3;fontFamily=Helvetica;fontSize=12;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="500" y="844" width="812" height="200" as="geometry"/></mxCell>
        <mxCell id="repeat" value="GOAL LOOP" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;horizontal=0;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="6" y="642" width="27" height="98" as="geometry"/></mxCell>

        <mxCell id="e1" value="invoke" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="goal" target="cli"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="load + admit" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="cli" target="checkpoint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="validated argv + recipe" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="checkpoint" target="engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-mcp" value="inspect / edit" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#60A5FA;strokeWidth=2;startArrow=block;startFill=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#2563EB;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="goal" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-project" value="project + simulator" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="project-input" target="engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-adapter" value="protocol v1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0891B2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#0E7490;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="adapter" target="replay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-install-durable" value="container preserved" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#4338CA;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="install" target="durable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-launch-ephemeral" value="new process" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#B45309;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="launch" target="ephemeral"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-replay-ephemeral" value="public UI reconstructs route" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0891B2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#0E7490;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="replay" target="ephemeral"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-http" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EA580C;strokeWidth=2;startArrow=block;startFill=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#C2410C;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="app" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-app-evidence" value="fresh accessibility observation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#15803D;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="app" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-backend-evidence" value="independent POST receipt" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#C2410C;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="backend" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-memory" value="optional descriptor lookup" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=6 4;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#7E22CE;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="memory" target="checkpoint"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="902"/><mxPoint x="480" y="332"/></Array></mxGeometry></mxCell>
        <mxCell id="e-loop" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 5;strokeColor=#16A34A;strokeWidth=3;endArrow=block;endFill=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evidence" target="goal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="488" y="1070"/><mxPoint x="20" y="1070"/><mxPoint x="20" y="264"/></Array></mxGeometry></mxCell>
