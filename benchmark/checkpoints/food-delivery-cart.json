  },
  "simulator": {
    "udid": "${MOOPS_SIMULATOR_UDID}"
  },
  "adapters": {
    "doctor": [
      [
        "/usr/bin/xcrun",
        "--find",
        "xcodebuild"
      ],
      [
        "/usr/bin/xcrun",
        "simctl",
        "getenv",
